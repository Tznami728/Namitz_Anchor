---
title: 部落格
---

{% extends "base.njk" %}

{% block content %}
<header>
  <h1>
    {{title}}
  </h1>
  <p>
    這裡是 Namitz 個人的文字記錄，基本上是想寫什麼就寫什麼。<br>
    你可以前往<a href="/">錨點</a>大概知道我是什麼樣的人。</p>
  </p>
  <hr>
</header>

<body>
<div class="flex-parent">
  <!-- 最新文章部分 -->
  {% if collections.posts.length > 0 %}
    {% set latestPost = collections.posts[0] %}
    <section class="flex-child-left">
      <article>
        <h2>最新 &nbsp;</h2>
        <h3><a href="{{ latestPost.url }}">{{ latestPost.data.title }}</a></h3>
        <p>{{ latestPost.templateContent | striptags | truncate(75, true, '...') }}</p>
        <p class="meta">{{ latestPost.data.date | strftime("%Y-%m-%d") }}
        <a href="{{ latestPost.url }}">→查看更多</a>
        </p>
      </article>
    </section>
  {% endif %}

  <!-- Hashtag列表部分 -->
  {% if collections.tagList.length > 0 %}
    <section class="flex-child-right">
      <h2>標籤</h2>
      <p  class="hashtag">
        {% for tag in collections.tagList %}
          <a href="/tags/{{ tag.slug }}/">#{{ tag.label }}({{ tag.posts.length }})</a>
          <!--<span class="meta">({{ tag.posts.length }})&nbsp;&nbsp;</span>-->
          &nbsp;&nbsp;<wbr>
        {% endfor %}
      </p>
      <p class="meta"><a href="/tags/index.html">→標籤分類頁面</a></p>
    </section>
  {% else %}
    <p>目前還沒有任何 hashtag。</p>
  {% endif %}
</div>
<hr>
  <!-- 所有文章列表 -->
  {% set currentYear = null %}
  
  {% for post in collections.posts %}
    {% if post.data.date %}
      {% set postYear = post.data.date | strftime("%Y") %}
      
      {% if postYear != currentYear %}
        {% if currentYear != null %}</ul>{% endif %}
        <h2>{{ postYear }}</h2>
        <ul>
        {% set currentYear = postYear %}
      {% endif %}
      
      {% set isCurrent = post.url == page.url %}
      <li class="{% if isCurrent %}active{% endif %}">
        <span class="meta">{{ post.data.date | strftime("%m-%d") }}</span>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </li>
      <br>
    {% endif %}
  {% endfor %}
  
  {% if currentYear != null %}
    </ul>
  {% endif %}
</body>

{% endblock %}