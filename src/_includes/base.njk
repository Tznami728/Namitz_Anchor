<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div class="layout">
    <main>
      {% block content %}{% endblock %}
    </main>
  </div>

  <!-- 底部導覽列 -->
  <footer class="bottom-nav">
    <nav class="bottom-nav-content">
      <div class="bottom-nav-title">
        <a href="/" class="{% if page.url == '/' %}active{% endif %}">Namitz's anchor</a>    
      </div>

      <input type="checkbox" id="burger">
      <div class="bottom-nav-links">
        <a href="/works/" class="{% if page.url == '/works/' or page.url.startsWith('/works/') %}active{% endif %}">編曲</a>
        <a href="/gallery/" class="{% if page.url == '/gallery/' or page.url.startsWith('/gallery/') %}active{% endif %}">寫真</a>
        <a href="/posts/" class="{% if page.url == '/posts/' or page.url.startsWith('/posts/') %}active{% endif %}">雜談</a>
        <a href="/links/" class="{% if page.url == '/links/' or page.url.startsWith('/links/') %}active{% endif %}">連結</a>
      </div>

      <div class="bottom-nav-button">
        <button class="theme-toggle" type="button" aria-label="切換夜間主題" aria-pressed="false" title="切換夜間主題">
          <img src="/images/DarkOff.webp" alt="切換主題">
        </button>
        <button onclick="copyUrl()" class="theme-toggle" type="button" aria-label="RSS訂閱" title="RSS feed訂閱">
          <img src="/images/RSSFeed.webp" alt="訂閱">
        </button>
      </div>

      <label for="burger"><img src="/images/MenuOff.webp" alt="選單"></label>

    </nav>
  </footer>

  <script>
    (function () {
      const body = document.body;
      const toggleButton = document.querySelector('.theme-toggle');
      const toggleIcon = document.querySelector('.theme-toggle img');

      const savedTheme = localStorage.getItem('theme');
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const theme = savedTheme || systemTheme;

      function applyTheme(nextTheme) {
        body.setAttribute('data-theme', nextTheme);
        localStorage.setItem('theme', nextTheme);

        if (toggleButton) {
          toggleButton.setAttribute('aria-pressed', String(nextTheme === 'dark'));
          toggleButton.setAttribute('title', nextTheme === 'dark' ? '切換至淺色模式' : '切換至夜間模式');
        }

        if (toggleIcon) {
          toggleIcon.src = nextTheme === 'dark' ? '/images/DarkOn.webp' : '/images/DarkOff.webp';
        }
      }

      applyTheme(theme);

      if (toggleButton) {
        toggleButton.addEventListener('click', () => {
          const nextTheme = body.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          applyTheme(nextTheme);
        });
      }
    })();
  </script>

  <script>
  function copyUrl() {
      const url = "https://namitz.com/feed.xml";

      navigator.clipboard.writeText(url)
          .then(() => {
              alert("已複製XML網址！接下來貼到閱讀器即完成訂閱。\n感謝你的訂閱！也隨時歡迎Email跟我交流。");
          })
          .catch(err => {
              console.error("複製失敗：", err);
          });
  }
  </script>


</body>
</html>